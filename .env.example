# Required by grader - Docker images
BLUE_IMAGE=your-dockerhub-username/your-app:latest
GREEN_IMAGE=your-dockerhub-username/your-app:latest

# Controls which pool is primary (blue|green)
ACTIVE_POOL=blue

# Release IDs returned in X-Release-Id header
RELEASE_ID_BLUE=blue-1.0.0
RELEASE_ID_GREEN=green-1.0.1

# Application port (optional, defaults to 3000)
PORT=3000